# AgentJava 运行配置示例
#
# 使用方式：复制本文件为 config.yaml，填入你自己的 api_key。
#   cp .agentjava/config.yaml.example .agentjava/config.yaml
#
# config.yaml 含真实密钥，已在 .gitignore 中忽略，不要提交。

providers:
  # Anthropic 官方：走 Messages API，支持扩展思考
  - name: anthropic-official
    protocol: anthropic
    base_url: https://api.anthropic.com
    api_key: "your-api-key-here"
    model: claude-sonnet-4-6
    thinking: true

  # OpenAI 官方：走 Chat Completions API
  # - name: openai-official
  #   protocol: openai
  #   base_url: https://api.openai.com/v1
  #   api_key: "your-api-key-here"
  #   model: gpt-4o

  # OpenAI 兼容服务（DeepSeek、Kimi、GLM、MiniMax 等）：
  # 协议填 openai-compat，base_url 必填
  # - name: my-compat-provider
  #   protocol: openai-compat
  #   base_url: https://api.example.com/v1
  #   api_key: "your-api-key-here"
  #   model: model-name

# 只配一个 provider 时，启动直接进入对话；
# 配了多个，启动后先用方向键选一个（选定后本次会话不再切换）。

# ───────────────────────── MCP Server 配置 ─────────────────────────
# 把外部 MCP Server 接进 AgentJava，无需改代码即可获得新工具。
# 支持两种传输：
#   - stdio：有 command 字段 → 作为本地子进程启动，走 stdin/stdout 管道
#   - http：有 url 字段 → 发 Streamable HTTP POST（远程 Server）
# 同名 Server 项目级覆盖用户级（~/.agentjava/config.yaml）。
# env / headers 里的 ${VAR} 会从当前环境变量展开，避免把密钥明文写进配置。
mcp_servers:
  # 本地 stdio 示例（需要 npx 与网络）
  # github:
  #   command: "npx"
  #   args: ["-y", "@modelcontextprotocol/server-github"]
  #   env:
  #     GITHUB_TOKEN: "${GITHUB_TOKEN}"

  # 远程 HTTP 示例（需要 Bearer Token）
  # remote-tool:
  #   url: "https://api.example.com/mcp"
  #   headers:
  #     Authorization: "Bearer ${API_TOKEN}"

